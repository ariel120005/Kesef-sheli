# Copy this file to .env and fill in the values from your Firebase project's
# web app config (Firebase Console → Project settings → General → Your apps →
# Web app → SDK setup and configuration → Config).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# MapTiler API key for the Map tab (web) — see CLAUDE.md's "MapTiler setup" section for how to
# get one. Free tier: 100,000 map loads/month, no credit card required.
EXPO_PUBLIC_MAPTILER_KEY=
